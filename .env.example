# Dev: use /api (Vite proxies to backend — see vite.config.ts)
VITE_API_BASE_URL=/api

# Production: point to your live API
# VITE_API_BASE_URL=https://api.yourdomain.com/api

# Dev proxy target (vite.config.ts only — NOT a VITE_ var; never shipped to the browser)
# PROXY_TARGET=https://backendmassaed.impactrealty.ae

# Sent as x-user-id on every assistant request
VITE_USER_ID=123456
